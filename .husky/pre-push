#!/usr/bin/env sh

echo "🔍 Running oxlint..."
if ! bunx oxlint; then
  echo "❌ oxlint found errors. Fix them before pushing."
  exit 1
fi

# Checks, never writes — and goes through `format:check` so `.oxfmtrc.json` is
# read.
#
# This used to run `oxfmt --write` over a `git ls-files` list and then
# `git add -u`. Two problems. An explicit file list **bypasses**
# `ignorePatterns`, so the hook reformatted the very generated files the config
# exists to protect. And at pre-push the commits are already made, so staging
# changed nothing about what was pushed — it only left the working tree dirty
# with edits to files the push had nothing to do with.
echo "✨ Checking formatting..."
if ! bun run format:check; then
  echo "❌ Formatting issues. Run 'bun run format' and commit the result."
  exit 1
fi

echo "✅ Lint and formatting clean."
